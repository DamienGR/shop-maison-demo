---
import type { ContentPageModel } from '../../features/storefront/models';

/**
 * Maison Démo — les pages de contenu.
 *
 * Le Markdown du marchand arrive déjà rendu et assaini : on l'insère, sans le
 * transformer. Deux marqueurs sont contractuels et restent : la classe
 * `markdown-content`, à laquelle toute la typographie de prose est accrochée,
 * et `style={model.layoutStyle}`, qui porte la largeur et l'alignement du
 * titre choisis dans l'administration.
 *
 * Le titre prend la version étendue du caractère, comme les titres de la
 * vitrine ; les images d'une page passent en pleine colonne (tokens.css).
 */
interface Props {
  model: ContentPageModel;
}

const { model } = Astro.props;
---

<article class="markdown-content md-page pb-8 pt-4" data-page-layout={model.layout} style={model.layoutStyle}>
  <h1>{model.title}</h1>
  <Fragment set:html={model.html} />
</article>
