---
import type { StorefrontShellModel } from '../../features/storefront/models';
import StoreNav from '../../features/storefront/controls/StoreNav.astro';
import StoreSearch from '../../features/storefront/controls/StoreSearch.astro';
import StoreCartControl from '../../features/storefront/controls/StoreCartControl.astro';
import StoreAccountControl from '../../features/storefront/controls/StoreAccountControl.astro';
import { t } from '../../features/i18n';

/**
 * Maison Démo — l'en-tête.
 *
 * Le mât classique d'une maison de mode : les rayons à gauche, la marque au
 * centre, la recherche et le panier à droite. Collant, parce qu'un panier doit
 * rester à portée au milieu d'une longue liste.
 *
 * Rendu sur TOUTES les pages, panier, commande, paiement et connexion admin
 * comprises : les contrôles du cœur restent tels quels, seuls leur place et
 * leur style changent.
 *
 * Sous `xl`, le menu marchand passe dans le <details> de <StoreNav>. Ce
 * <details> est rendu `static` pour que son panneau se positionne sur toute la
 * largeur de l'en-tête plutôt que sous l'icône (voir tokens.css).
 */
interface Props {
  model: StorefrontShellModel;
}

const { model } = Astro.props;
const control = 'text-[0.8125rem] font-medium text-ink transition-colors hover:text-brand';
---

{
  model.announcement && (
    <div class="bg-brand text-on-brand">
      <p class="mx-auto max-w-[var(--page-max)] px-[var(--page-pad-x)] py-2.5 text-center text-[0.78rem] font-medium tracking-[0.01em]">
        {model.announcement.href ? (
          <a href={model.announcement.href} class="underline-offset-4 hover:underline">
            {model.announcement.text}
          </a>
        ) : (
          model.announcement.text
        )}
      </p>
    </div>
  )
}

<header class="md-header sticky top-0 z-30 border-b border-line bg-paper">
  <div
    class="relative mx-auto grid h-16 max-w-[var(--page-max)] grid-cols-[minmax(0,1fr)_auto_minmax(0,1fr)] items-center gap-2 px-[var(--page-pad-x)] sm:gap-4 lg:h-[4.5rem]"
  >
    <div class="flex min-w-0 items-center">
      {
        model.headerLinks.length > 0 && (
          <nav aria-label={t('shell.nav.primary')} class="flex min-w-0 items-center">
            <StoreNav
              links={model.headerLinks}
              class={`hidden min-w-0 items-center gap-6 xl:flex ${control}`}
              disclosureClass="static text-ink xl:hidden"
            />
          </nav>
        )
      }
    </div>

    <a href="/" aria-label={model.storeName} class="col-start-2 justify-self-center">
      {
        model.logo ? (
          <img src={model.logo.src} alt={model.logo.alt} class="h-7 max-w-48 object-contain lg:h-8" />
        ) : (
          <span class="md-wordmark block whitespace-nowrap text-[0.9rem] text-ink min-[400px]:text-[1rem] sm:text-[1.25rem] lg:text-[1.4rem]">
            {model.storeName}
          </span>
        )
      }
    </a>

    <div class="col-start-3 flex min-w-0 items-center justify-end gap-4 sm:gap-5 lg:gap-7">
      <div class="hidden items-center gap-2 border-b border-line pb-1 transition-colors focus-within:border-ink lg:flex">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true" class="shrink-0 text-muted">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
        <StoreSearch
          action={model.search.action}
          query={model.search.query}
          inputClass="w-36 bg-transparent text-[0.8125rem] text-ink placeholder:text-muted focus:outline-none xl:w-44"
        />
      </div>
      <a href={model.search.action} aria-label={t('shell.search.link')} class={`${control} lg:hidden`}>
        <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <circle cx="11" cy="11" r="7" />
          <path d="m20 20-3.5-3.5" />
        </svg>
      </a>
      {model.account.enabled && <StoreAccountControl href={model.account.href} class={`${control} hidden sm:inline-flex`} />}
      {model.cart.enabled && <StoreCartControl href={model.cart.href} class={`${control} inline-flex items-center whitespace-nowrap`} />}
    </div>
  </div>
</header>
