---
import type { ProductCardModel } from '../../features/storefront/models';
import StoreImage from '../../features/storefront/controls/StoreImage.astro';
import { t } from '../../features/i18n';

/**
 * Maison Démo — une silhouette, son nom, son prix.
 *
 * Les photographies sont en pied, au format 2:3 : la vignette le respecte au
 * lieu de rogner la tête ou les chaussures. Dessous, le nom et le prix sur deux
 * lignes courtes, sans ornement ; la photographie fait tout le travail.
 *
 * Une seule ancre pour toute la carte, pour ne pas faire tabuler deux fois. Le
 * prix arrive formaté, la disponibilité est un booléen : rien ne se recalcule
 * ici.
 */
interface Props {
  card: ProductCardModel;
  index?: number;
  headingLevel?: 'h2' | 'h3';
}

const { card, headingLevel = 'h2' } = Astro.props;
const Heading = headingLevel;
---

<li class="group min-w-0">
  <a href={card.href} class="block">
    <div class="relative overflow-hidden bg-surface">
      <StoreImage
        image={card.image}
        fade
        class={`aspect-[2/3] w-full object-cover transition-opacity duration-300 group-hover:opacity-90${card.inStock ? '' : ' opacity-60'}`}
      />
      {
        !card.inStock && (
          <span class="absolute left-3 top-3 bg-paper px-2 py-1 text-[0.72rem] font-medium text-ink">
            {t('product.soldOut')}
          </span>
        )
      }
    </div>
    <div class="mt-3 flex flex-col gap-0.5 pr-2">
      <Heading class="text-[0.875rem] font-medium leading-snug text-ink decoration-1 underline-offset-4 group-hover:underline">
        {card.name}
      </Heading>
      <span class="text-[0.875rem] tabular-nums text-muted">{card.formattedPrice}</span>
    </div>
  </a>
</li>
